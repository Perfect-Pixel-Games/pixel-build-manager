# Auto-detect text files and normalize line endings to LF in the repo.
* text=auto eol=lf

# Windows scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary/asset formats — never diff or normalize these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.exe binary
*.msi binary
*.dll binary
*.zip binary
*.tar.gz binary
*.woff binary
*.woff2 binary
